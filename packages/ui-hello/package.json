{
  "name": "@auto-coding/ui-hello",
  "description": "Scaffold UI plugin: one additive sidebar footer action (Web GUI client half)",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.0.1-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-runtime": "link:/root/workspace/deepseek-harness/packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-sidebar": "link:/root/workspace/deepseek-harness/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-slots": "link:/root/workspace/deepseek-harness/packages/client/ui-slots",
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.2"
  },
  "files": [
    "lib",
    "src",
    "package.json"
  ]
}
