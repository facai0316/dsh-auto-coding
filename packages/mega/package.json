{
  "name": "@auto-coding/mega",
  "description": "The auto-coding pipeline as ONE distributable dsh bundle: db-pgmas, cm-flow, cm-worker, and the requirements panel shipped as multi-entry package (./db ./flow ./worker ./client) with a bundle patch — git clone + `dsh plugin add` mounts all four rows",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./db": "./lib/db.js",
    "./flow": "./lib/flow.js",
    "./worker": "./lib/worker.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@douyinfe/semi-ui": "^2.102.0",
    "marked": "^18.0.9",
    "pg": "^8.23.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.5",
    "@deepseek-ai/schemastery": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:/root/workspace/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:/root/workspace/deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-client-runtime": "link:/root/workspace/deepseek-harness/packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-conversation": "link:/root/workspace/deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-theme": "link:/root/workspace/deepseek-harness/packages/client/ui-theme",
    "@deepseek-ai/dsh-subagent": "link:/root/workspace/deepseek-harness/packages/subagent/subagent",
    "@deepseek-ai/dsh-tools": "link:/root/workspace/deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-typert-protocol": "link:/root/workspace/deepseek-harness/packages/typert/protocol",
    "@deepseek-ai/schemastery": "link:/root/workspace/deepseek-harness/vendor/schemastery",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "assets",
    "package.json"
  ]
}
